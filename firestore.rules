rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user (anonymous auth) can only ever read/write
    // documents that live under their own uid. Nobody can read or
    // write another user's data, and nobody can access anything
    // while signed out.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Covers /users/{uid}/meta/timetable, /users/{uid}/attendance/{date},
      // /users/{uid}/assignments/{id}, and anything else nested under the user.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
